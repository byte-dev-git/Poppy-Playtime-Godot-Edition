[sub_resource type="Shader" id="Shader_xi01o"]
code = "shader_type spatial;
// blend_add суммирует цвета. depth_test_disabled часто полезен для спецэффектов.
render_mode blend_add, depth_draw_opaque, cull_disabled;

uniform sampler2D desa_tex : source_color, filter_linear_mipmap;
uniform sampler2D mv_tex : hint_normal; 
uniform vec4 emissive_tint : source_color = vec4(1.0, 0.23, 0.0, 1.0);

uniform int h_frames = 8;
uniform int v_frames = 8;
uniform float motion_vector_strength = 0.5; // Увеличил для наглядности

varying float particle_alpha;
varying float frame_lerp;
varying vec2 frame_uv_size;
varying vec4 particle_color; // Цвет из ParticleProcessMaterial

void vertex() {
	float res_size_x = length(MODEL_MATRIX[0].xyz);
    float res_size_y = length(MODEL_MATRIX[1].xyz);
    float res_size_z = length(MODEL_MATRIX[2].xyz);
    
    MODELVIEW_MATRIX[0].xyz = vec3(res_size_x, 0.0, 0.0);
    MODELVIEW_MATRIX[1].xyz = vec3(0.0, res_size_y, 0.0);
    MODELVIEW_MATRIX[2].xyz = vec3(0.0, 0.0, res_size_z);
	
	particle_color = COLOR;
	
    float animation_progress = INSTANCE_CUSTOM.z;
    float total_frames = float(h_frames * v_frames);
    float current_frame = floor(animation_progress * (total_frames - 0.001));
    
    frame_uv_size = vec2(1.0 / float(h_frames), 1.0 / float(v_frames));
    float frame_x = mod(current_frame, float(h_frames));
    float frame_y = floor(current_frame / float(h_frames));
    
    frame_lerp = fract(animation_progress * total_frames);
    
    // Модифицируем UV
    UV = UV * frame_uv_size + vec2(frame_x, frame_y) * frame_uv_size;
    
    // Берем и альфу, и встроенный цвет частицы (из Color Ramp)
    particle_alpha = INSTANCE_CUSTOM.a;
    particle_color = COLOR; 
}

void fragment() {
    // 1. Читаем Motion Vectors
    vec2 mv_sample = texture(mv_tex, UV).rg;
    vec2 mv_data = (mv_sample * 2.0 - 1.0);
    
    // 2. Искажаем UV (важно: ограничиваем влияние размером кадра)
    vec2 distorted_uv = UV - (mv_data * frame_lerp * motion_vector_strength * frame_uv_size);
    
    // 3. Читаем DESA
    vec4 desa = texture(desa_tex, distorted_uv);
    
    float density = desa.r;
    float emissive_mask = desa.g;
    float alpha_mask = desa.a;
    
    // Вычисляем итоговый цвет
    // Умножаем на particle_color.rgb, если в ParticleProcessMaterial настроен градиент
    vec3 final_color = emissive_tint.rgb * emissive_mask * particle_color.rgb;
    
    // Усиление для свечения (HDR)
    ALBEDO = final_color * 2.0;
	EMISSION = final_color * density * 10.0;
    
    // Главное исправление: ALPHA не должна быть всегда 1.0
    // Умножаем маску из текстуры на альфу частицы
    ALPHA = alpha_mask * particle_alpha * particle_color.a * emissive_tint.a;
}
"

