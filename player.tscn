[sub_resource type="ShaderMaterial" id="ShaderMaterial_iyprq"]

[sub_resource type="Shader" id="Shader_o1qou"]
code = "shader_type canvas_item;

uniform sampler2D tex_base : source_color;
uniform sampler2D tex_empty : source_color;
uniform sampler2D tex_filled : source_color;

uniform float value : hint_range(0.0, 1.0) = 0.5;
uniform float center_y_offset : hint_range(0.0, 1.0) = 0.8;

void fragment() {
    vec4 base_col = texture(tex_base, UV);
    vec4 empty_col = texture(tex_empty, UV);
    vec4 filled_col = texture(tex_filled, UV);
    
    vec2 center = vec2(0.5, center_y_offset);
    vec2 uv = UV - center;
    float angle = atan(-uv.y, uv.x);
    
    float t = clamp(angle / 3.14159265359, 0.0, 1.0);
    float progress_t = 1.0 - t;
    
    float mask = smoothstep(value + 0.005, value - 0.005, progress_t);
    
    vec4 gauge_layer = mix(empty_col, filled_col, mask);
    
    vec3 final_rgb = mix(base_col.rgb, gauge_layer.rgb, gauge_layer.a);
    
    float final_a = max(base_col.a, gauge_layer.a);
    
    COLOR = vec4(final_rgb, final_a);
}
"

