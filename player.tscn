[sub_resource type="ShaderMaterial" id="ShaderMaterial_fm063"]

[sub_resource type="Shader" id="Shader_a838d"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture;
uniform float noise_intensity : hint_range(0.0, 1.0) = 0.05; 

float random(vec2 uv) {
    return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
    vec2 uv = SCREEN_UV;
    vec4 color = texture(SCREEN_TEXTURE, uv);

    float noise = random(uv + TIME) * 2.0 - 1.0;

    color.rgb += noise * noise_intensity;

    COLOR = color;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_36n6d"]
shader = SubResource("Shader_a838d")
shader_parameter/noise_intensity = 1.0

